# Copy to .env. Never commit real credentials.
MODEL_API_BASE=https://api.a6api.com/v1
MODEL_API_KEY=
MODEL_NAME=claude-sonnet-5-5
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# For Railway: export-session writes this secret to data/railway-session.env.
TELEGRAM_SESSION=
# Empty = reply to all incoming private human accounts. Optional comma-separated allowlist.
ALLOWED_USER_IDS=
DATA_DIR=data
ENABLE_TRANSCRIPTION=true
# Optional: pip install -e ".[audio]"; the first use downloads this local speech model.
WHISPER_MODEL=base
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Fish Audio is a separate provider with its own key.
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_REFERENCE_ID=41d6b093e3014fb097a0b3eb1749247c
FISH_SPEED=1.0
# auto: voice replies to voice messages, or after /ai_voice_on; text is always sent.
VOICE_REPLIES=auto
# Experimental real P2P calls. Requires .[calls], transcription, Fish key and allowlist.
ENABLE_CALLS=false
CALL_ALLOWED_USER_IDS=

# Original correspondence stays on disk until /ai_reset. These limits affect model context.
MEMORY_RECENT_TURNS=24
MEMORY_SUMMARY_THRESHOLD=32
MEMORY_CONTEXT_CHARS=100000
MEMORY_SUMMARY_CHARS=18000

# Optional reliable search API. Empty uses public web search (may be rate-limited).
TAVILY_API_KEY=

# Private archive viewer. Set a unique password (at least 16 characters).
# Empty disables the viewer; archiving still runs. Railway supplies PORT automatically.
ARCHIVE_PASSWORD=
ARCHIVE_PORT=8080

